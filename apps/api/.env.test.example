# Test database for the API e2e suite. Copy to apps/api/.env.test and adjust if your
# local Postgres differs. EMAIL_PROVIDER must remain 'log' so tests can capture mails.
NODE_ENV=local
PORT=3002
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://pintoria:pintoria@localhost:5432/pintoria_test

# Secrets may stay local-dev placeholders in .env.test
JWT_ACCESS_SECRET=test-access-secret-0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=test-refresh-secret-0123456789abcdef0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

EMAIL_PROVIDER=log
EMAIL_FROM=Printoria Portal <no-reply@printoria.example>

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/test-files

UPLOAD_MAX_MB=25
UPLOAD_ALLOWED_EXT=pdf,jpg,jpeg,png,xlsx,docx,ai,cdr

{
  "name": "pintoria",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "npm install && npm run build -w @pintoria/shared",
    "predev": "npm run build -w @pintoria/shared",
    "dev": "concurrently -n api,web,shared \"npm run start:dev -w apps/api\" \"npm run dev -w apps/web\" \"npm run dev -w @pintoria/shared\"",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w @pintoria/shared && npm run build -w apps/api && npm run build -w apps/web",
    "start:api": "npm run start -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:reset": "npm run db:reset -w apps/api",
    "db:test:reset": "npm run db:test:reset -w apps/api",
    "create-admin": "npm run create-admin -w apps/api",
    "test": "npm run test -w apps/api",
    "test:e2e": "npm run test:e2e -w apps/api",
    "lint": "npm run lint -w apps/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "pg:start": "node scripts/dev-postgres.mjs start",
    "pg:stop": "node scripts/dev-postgres.mjs stop",
    "pg:status": "node scripts/dev-postgres.mjs status"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.3.3"
  }
}
